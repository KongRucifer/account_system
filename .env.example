# Database
DATABASE_URL="postgresql://username:password@localhost:5432/account_system?schema=public"

# JWT
JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"

# Firebase Admin (ต้องการสำหรับ Push Notification)
# Option 1: ใช้ไฟล์ JSON (ง่ายกว่า)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Option 2: ใส่ค่าตรงใน .env (ไม่ต้องมีไฟล์)
# FIREBASE_PROJECT_ID="lanxangaap"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@lanxangaap.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server
PORT=4000
