model Nso {
  id                     String   @id @db.VarChar(3)
  licensingFormEng       String   @map("licensingform_eng") @db.VarChar
  licensingFormLao       String   @map("licensingform_lao") @db.VarChar
  nsoNameEng             String   @map("nso_name_eng") @db.VarChar
  nsoNameLao             String   @map("nso_name_lao") @db.VarChar
  addressLineEng         String?  @map("adressline_eng") @db.VarChar
  addressLineLao         String?  @map("adressline_lao") @db.VarChar
  addressCityEng         String?  @map("adresscity_eng") @db.VarChar
  addressCityLao         String?  @map("adresscity_lao") @db.VarChar
  provinceId             String   @map("province_id") @db.VarChar(2)
  districtId             String   @map("district_id") @db.VarChar(4)
  countryId              String   @map("country_id") @db.VarChar(3)
  statusId               String   @map("status_id") @db.VarChar(1)
  distrKeyVbFundMin      Decimal? @map("distr_key_vb_fund_min") @db.Decimal
  distrKeyVbFundMax      Decimal? @map("distr_key_vb_fund_max") @db.Decimal
  distrKeyReserveMin     Decimal? @map("distr_key_reserve_min") @db.Decimal
  distrKeyVbCommitteeMin Decimal? @map("distr_key_vb_committee_min") @db.Decimal
  distrKeyVbCommitteeMax Decimal? @map("distr_key_vb_committee_max") @db.Decimal
  needSync               String?  @map("need_sync") @db.VarChar(1)
  distrKeyVbWelfareMin   Decimal? @map("distr_key_vb_welfare_min") @db.Decimal

  province           Province            @relation(fields: [provinceId], references: [id])
  district           District            @relation(fields: [districtId], references: [id])
  country            Country             @relation(fields: [countryId], references: [countryId])
  status             Status              @relation(fields: [statusId], references: [id])
  nsoOffices         NsoOffice[]
  nsoEmployees       NsoEmployee[]
  nsoFeeModels       NsoFeeModel[]
  nsoFeeTransactions NsoFeeTransaction[]

  @@map("nso")
}

model NsoOffice {
  id          String  @id @db.VarChar(6)
  officeNo    String  @map("office_no") @db.VarChar(3)
  provinceId  String  @map("province_id") @db.VarChar(2)
  districtId  String  @map("district_id") @db.VarChar(4)
  locationEng String? @map("location_eng") @db.VarChar
  locationLao String? @map("location_lao") @db.VarChar
  nsoId       String  @map("nso_id") @db.VarChar(3)
  statusId    String  @map("status_id") @db.VarChar(1)
  needSync    String? @map("need_sync") @db.VarChar(1)

  nso                   Nso                    @relation(fields: [nsoId], references: [id])
  province              Province               @relation(fields: [provinceId], references: [id])
  district              District               @relation(fields: [districtId], references: [id])
  status                Status                 @relation(fields: [statusId], references: [id])
  nsoEmployees          NsoEmployee[]
  villageBanks          VillageBank[]
  vbFieldStaffMatchings VbFieldstaffMatching[]

  @@map("nso_office")
}

model NsoEmployee {
  id           String    @id @db.VarChar(6)
  emplNo       String    @map("empl_no") @db.VarChar(3)
  userName     String    @map("user_name") @db.VarChar
  nsoId        String    @map("nso_id") @db.VarChar(3)
  nsoOfficeId  String    @map("nso_office_id") @db.VarChar(6)
  firstNameEng String?   @map("firstname_eng") @db.VarChar
  lastNameEng  String?   @map("lastname_eng") @db.VarChar
  firstNameLao String    @map("firstname_lao") @db.VarChar
  lastNameLao  String?   @map("lastname_lao") @db.VarChar
  birthDate    DateTime  @map("birthdate") @db.Date
  birthPlace   String?   @map("birthplace") @db.VarChar
  genderEng    String?   @map("gender_eng") @db.VarChar(10)
  genderLao    String?   @map("gender_lao") @db.VarChar(10)
  hireDate     DateTime  @map("hiredate") @db.Date
  dateLeft     DateTime? @map("date_left") @db.Date
  phone        String?   @db.VarChar
  statusId     String    @map("status_id") @db.VarChar(1)
  grossSalary  String    @map("gross_salary") @db.VarChar
  email        String?   @db.VarChar
  jobTitleId1  String    @map("jobtitle_id_1") @db.VarChar(2)
  jobTitleId2  String?   @map("jobtitle_id_2") @db.VarChar(2)
  bankAccount  String?   @map("bankaccount") @db.VarChar
  bankName     String?   @map("bankname") @db.VarChar
  countryId    String    @map("country_id") @db.VarChar(3)
  needSync     String?   @map("need_sync") @db.VarChar(1)
  years        String?   @db.VarChar(4)

  nso                   Nso                    @relation(fields: [nsoId], references: [id])
  nsoOffice             NsoOffice              @relation(fields: [nsoOfficeId], references: [id])
  status                Status                 @relation(fields: [statusId], references: [id])
  jobTitle1             JobTitle               @relation("JobTitle1", fields: [jobTitleId1], references: [id])
  jobTitle2             JobTitle?              @relation("JobTitle2", fields: [jobTitleId2], references: [id])
  country               Country                @relation(fields: [countryId], references: [countryId])
  systemUsers           SystemUser[]
  events                Events[]
  vbServiceDays         VbServiceDays[]
  vbFieldStaffMatchings VbFieldstaffMatching[]
  notifications         Notification[]

  @@map("nso_employee")
}

model NsoFeeModel {
  id            BigInt    @id @default(autoincrement())
  nsoYearlyFee  Decimal   @map("nso_yearlyfee") @db.Decimal
  nsoMonthlyFee Decimal   @map("nso_monthlyfee") @db.Decimal
  isCapped      String    @map("is_capped") @db.VarChar(1)
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  nsoId         String?   @map("nso_id") @db.VarChar(3)
  statusId      String?   @map("status_id") @db.VarChar(1)
  needSync      String?   @map("need_sync") @db.VarChar(1)
  maxFee        Decimal?  @db.Decimal
  // Step tiers
  step1         Decimal?  @db.Decimal
  step2         Decimal?  @db.Decimal
  step3         Decimal?  @db.Decimal
  step4         Decimal?  @db.Decimal
  step5         Decimal?  @db.Decimal
  step6         Decimal?  @db.Decimal
  step7         Decimal?  @db.Decimal
  step8         Decimal?  @db.Decimal
  rateApplied1  Decimal?  @map("rate_applied1") @db.Decimal
  rateApplied2  Decimal?  @map("rate_applied2") @db.Decimal
  rateApplied3  Decimal?  @map("rate_applied3") @db.Decimal
  rateApplied4  Decimal?  @map("rate_applied4") @db.Decimal
  rateApplied5  Decimal?  @map("rate_applied5") @db.Decimal
  rateApplied6  Decimal?  @map("rate_applied6") @db.Decimal
  rateApplied7  Decimal?  @map("rate_applied7") @db.Decimal
  rateApplied8  Decimal?  @map("rate_applied8") @db.Decimal

  nso                Nso?                @relation(fields: [nsoId], references: [id])
