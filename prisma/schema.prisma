generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Authentication & Authorization Tables
// ============================================================

model SystemUser {
  id            Int     @id @default(autoincrement())
  userName      String  @map("user_name") @db.VarChar
  password      String  @db.Text
  nsoEmployeeId String? @map("nso_employee_id") @db.VarChar(6)
  statusId      String? @map("status_id") @db.VarChar(1)
  needSync      String? @map("need_sync") @db.VarChar(1)

  nsoEmployee NsoEmployee?             @relation(fields: [nsoEmployeeId], references: [id])
  status      Status?                  @relation(fields: [statusId], references: [id])
  roles       SystemUserRoleMatching[]
  logging     Logging[]

  @@map("system_user")
}

model SystemRole {
  id       String  @id @db.VarChar(3)
  nameEng  String  @map("name_eng") @db.VarChar
  nameLao  String  @map("name_lao") @db.VarChar
  needSync String? @map("need_sync") @db.VarChar(1)

  users         SystemUserRoleMatching[]
  notifications Notification[]

  @@map("system_role")
}

model SystemUserRoleMatching {
  systemRoleId String  @map("system_role_id") @db.VarChar(3)
  systemUserId Int     @map("system_user_id")
  needSync     String? @map("need_sync") @db.VarChar(1)

  systemRole SystemRole @relation(fields: [systemRoleId], references: [id])
  systemUser SystemUser @relation(fields: [systemUserId], references: [id])

  @@id([systemRoleId, systemUserId])
  @@map("system_user_role_matching")
}

model Logging {
  id           BigInt    @id @default(autoincrement())
  loginTime    DateTime? @map("login_time") @db.Timestamp(6)
  logoutTime   DateTime? @map("logout_time") @db.Timestamp(6)
  systemUserId Int       @map("system_user_id")
  needSync     String?   @map("need_sync") @db.VarChar(1)

  systemUser SystemUser @relation(fields: [systemUserId], references: [id])

  @@map("logging")
}

// ============================================================
// Reference/Lookup Tables
// ============================================================

model Status {
  id       String  @id @db.VarChar(2)
  nameEng  String  @map("name_eng") @db.VarChar
  nameLao  String  @map("name_lao") @db.VarChar
  needSync String? @map("need_sync") @db.VarChar(1)

  // Relations
  systemUsers                      SystemUser[]
  nsoEmployees                     NsoEmployee[]
  nso                              Nso[]
  nsoOffices                       NsoOffice[]
  nsoFeeModels                     NsoFeeModel[]
  villageBanks                     VillageBank[]
  accounts                         Accounts[]
  chartOfAccounts                  ChartOfAccounts[]
  clientLoanArrangements           ClientLoanArrangement[]
  clientLoanRules                  ClientLoanRule[]
  clientSavingConditions           ClientSavingCondition[]
  clientEquitySavingArrangements   ClientEquitySavingArrangement[]
  vbNsoSavingArrangements          VbNsoSavingArrangement[]
  vbNsoSavingConditions            VbNsoSavingConditions[]
  vbNsoSavingTypes                 VbNsoSavingType[]
  nsoVbWsloanConditions            NsoVbWsloanCondition[]
  nsoVbWsloanArrangements          NsoVbWsloanArrangement[]
  vbAssetArrangements              VbAssetArrangement[]
  vbAssetTypes                     VbAssetType[]
  vbCommitteeTeams                 VbCommitteeTeam[]
  profitDistributionRules          ProfitDistributionRule[]
  profitDistributionArrangements   ProfitDistributionArrangement[]
  vat                              Vat[]
  clientLoanLossProvisioningModels ClientLoanLossProvisioningModel[]
  client                           Client[]
  notifications                    Notification[]

  @@map("status")
}

model Province {
  id       String  @id @db.VarChar(2)
  nameEng  String  @map("name_eng") @db.VarChar
  nameLao  String  @map("name_lao") @db.VarChar
  needSync String? @map("need_sync") @db.VarChar(1)

  districts  District[]
  vbCodes    VbCode[]
  vbCode2s   VbCode2[]
  nsos       Nso[]
  nsoOffices NsoOffice[]
  villages   Village[]

  @@map("province")
}

model District {
  id         String  @id @db.VarChar(4)
  nameEng    String  @map("name_eng") @db.VarChar
  nameLao    String  @map("name_lao") @db.VarChar
  provinceId String  @map("province_id") @db.VarChar(2)
  districtNo String  @map("district_no") @db.VarChar(2)
  needSync   String? @map("need_sync") @db.VarChar(1)

  province   Province    @relation(fields: [provinceId], references: [id])
  vbCodes    VbCode[]
  vbCode2s   VbCode2[]
  nsos       Nso[]
  nsoOffices NsoOffice[]

  @@map("district")
}

model Country {
  countryId  String  @id @db.VarChar(3)
  nameEng    String  @map("name_eng") @db.VarChar
  nameLao    String  @map("name_lao") @db.VarChar
  alpha2Code String  @map("alpha2code") @db.VarChar(2)
  alpha3Code String  @map("alpha3code") @db.VarChar(3)
  needSync   String? @map("need_sync") @db.VarChar(1)

  nsos         Nso[]
  nsoEmployees NsoEmployee[]
  vats         Vat[]

  @@map("countries")
}

model EthnicGroup {
  id       String  @id @db.VarChar(2)
  nameEng  String? @map("name_eng") @db.VarChar
  nameLao  String? @map("name_lao") @db.VarChar
  needSync String? @map("need_sync") @db.VarChar(1)

  villages Village[]

  @@map("ethnicgroup")
}

model EconomicStatus {
  id       String  @id @db.VarChar(1)
  nameEng  String  @map("name_eng") @db.VarChar
  nameLao  String  @map("name_lao") @db.VarChar
  needSync String? @map("need_sync") @db.VarChar(1)

  clients Client[]

  @@map("economic_status")
}

model Profession {
  id         String  @id @db.VarChar(2)
  nameLao    String  @map("name_lao") @db.VarChar
  nameEng    String  @map("name_eng") @db.VarChar
  isDropDown String  @map("is_drop_down") @db.VarChar(1)
  needSync   String? @map("need_sync") @db.VarChar(1)

  clients Client[]

  @@map("profession")
}

model JobTitle {
  id       String  @id @db.VarChar(2)
  nameEng  String  @map("name_eng") @db.VarChar
  nameLao  String  @map("name_lao") @db.VarChar
  needSync String? @map("need_sync") @db.VarChar(1)

  nsoEmployees1 NsoEmployee[] @relation("JobTitle1")
  nsoEmployees2 NsoEmployee[] @relation("JobTitle2")

  @@map("jobtitle")
}

model CnyLakRate {
  date         DateTime  @db.Date
  yuanToLak    Decimal   @map("yuan_to_lak") @db.Decimal(255, 0)
  vbCode       String    @map("vbcode") @db.VarChar(7)
  synchronized DateTime? @db.Timestamp(6)
  needSync     String?   @map("need_sync") @db.VarChar(1)

  vb VbCode @relation(fields: [vbCode], references: [id])

  @@id([date, vbCode])
  @@map("cny_lak_rate")
}

model Vat {
  id        BigInt    @id @default(autoincrement())
  vatRate   Decimal   @map("vat_rate") @db.Decimal(10, 5)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  countryId String?   @map("coutntry_id") @db.VarChar(3)
  statusId  String?   @map("status") @db.VarChar(1)
  needSync  String?   @map("need_sync") @db.VarChar(1)

  country Country? @relation(fields: [countryId], references: [countryId])
  status  Status?  @relation(fields: [statusId], references: [id])

  @@map("vat")
}

// ============================================================
// Village Bank (VB) Core Tables
// ============================================================

model VbCode {
  id         String  @id @db.VarChar(7)
  provinceId String  @map("province_id") @db.VarChar(2)
  districtId String  @map("district_id") @db.VarChar(4)
  villageId  String  @map("village_id") @db.VarChar(3)
  nameEng    String  @map("name_eng") @db.VarChar
  nameLao    String  @map("name_lao") @db.VarChar
  needSync   String? @map("need_sync") @db.VarChar(1)
  vbIdOld    String? @map("vb_id_old") @db.VarChar(7)

  province    Province     @relation(fields: [provinceId], references: [id])
  district    District     @relation(fields: [districtId], references: [id])
  village     Village?     @relation(fields: [id], references: [vbCode])
  villageBank VillageBank?

  // Relations
  clients                        Client[]
  accounts                       Accounts[]
  accountOwners                  AccountOwner[]
  transactions                   Transactions[]
  balance                        Balance[]
  generalLedger                  GeneralLedger[]
  trialBalance                   TrialBalance[]
  profitAndLoss                  ProfitAndLoss[]
  clientLoanArrangements         ClientLoanArrangement[]
  clientInstallmentLoanPlans     ClientInstallmentLoanPlan[]
  clientLoanLossProvisioning     ClientLoanLossProvisioning[]
  clientLoanRules                ClientLoanRule[]
  clientSavingArrangements       ClientSavingArrangement[]
  clientEquitySavingArrangements ClientEquitySavingArrangement[]
  clientSavingConditions         ClientSavingCondition[]
  vbNsoSavingArrangements        VbNsoSavingArrangement[]
  vbNsoSavingConditions          VbNsoSavingConditions[]
  nsoVbWsloanArrangements        NsoVbWsloanArrangement[]
  nsoShares                      NsoShares[]
  nsoFeeTransactions             NsoFeeTransaction[]
  vbTargets                      VbTargets[]
  vbServiceDays                  VbServiceDays[]
  vbCommitteeTeams               VbCommitteeTeam[]
  vbFieldStaffMatchings          VbFieldstaffMatching[]
  vbAssetArrangements            VbAssetArrangement[]
  profitDistrVbFunds             ProfitDistrVbFund[]
  profitDistrVbMembers           ProfitDistrVbMember[]
  profitDistrVbReserves          ProfitDistrVbReserve[]
  profitDistrVbcs                ProfitDistrVbc[]
  profitDistributionArrangements ProfitDistributionArrangement[]
  events                         Events[]
  notifications                  Notification[]
  ews                            Ews[]
  cnyLakRates                    CnyLakRate[]
  profitDistributionRules        ProfitDistributionRule[]
  clientAccounts                 ClientAccount[]

  @@map("vbcode")
}

model VbCode2 {
  id         String   @id @db.VarChar(7)
  provinceId String   @map("province_id") @db.VarChar(2)
  districtId String   @map("district_id") @db.VarChar(4)
  villageId  String   @map("village_id") @db.VarChar(3)
  nameEng    String   @map("name_eng") @db.VarChar
  nameLao    String   @map("name_lao") @db.VarChar
  needSync   String?  @map("need_sync") @db.VarChar(1)
  vbIdOld    String?  @map("vb_id_old") @db.VarChar(7)
  province   Province @relation(fields: [provinceId], references: [id])
  district   District @relation(fields: [districtId], references: [id])

  @@map("vbcode2")
}

model VillageBank {
  vbCode                     String    @id @map("vbcode") @db.VarChar(7)
  foundingDate               DateTime  @map("foundingdate") @db.Date
  nameEng                    String    @map("name_eng") @db.VarChar
  nameLao                    String    @map("name_lao") @db.VarChar
  startMonthBusinessYear     Int       @map("startmonthbusinessyear")
  monthlyMeetingDate         Int       @map("monthlymeetingdate")
  monthlyMeetingDateDuration Int       @map("monthlymeetingdate_duration")
  minimumSaving              Int       @map("minimum_saving")
  maximumSaving              BigInt    @map("maximum_saving")
  currency                   String    @db.VarChar(3)
  nsoOfficeId                String    @map("nso_office_id") @db.VarChar(6)
  statusId                   String    @map("status_id") @db.VarChar(1)
  equitySavingOnly           String    @map("equity_saving_only") @db.VarChar(1)
  synchronized               DateTime? @db.Timestamp(6)
  needSync                   String?   @map("need_sync") @db.VarChar(1)
  vbIdOld                    String?   @map("vb_id_old") @db.VarChar(7)
  exceptFee                  String?   @map("except_fee") @db.VarChar(1)

  vb        VbCode    @relation(fields: [vbCode], references: [id])
  nsoOffice NsoOffice @relation(fields: [nsoOfficeId], references: [id])
  status    Status    @relation(fields: [statusId], references: [id])

  @@map("villagebank")
}

model Village {
  vbCode           String    @id @map("vbcode") @db.VarChar(7)
  nameEng          String    @map("name_eng") @db.VarChar
  nameLao          String    @map("name_lao") @db.VarChar
  ethnicGroupId    String    @map("ethnicgroup_id") @db.VarChar(2)
  families         Int?
  households       Int?
  population       Int?
  femalePopulation Int?      @map("femalepopulation")
  synchronized     DateTime? @db.Timestamp(6)
  needSync         String?   @map("need_sync") @db.VarChar(1)

  ethnicGroup    EthnicGroup @relation(fields: [ethnicGroupId], references: [id])
  vbCodeRelation VbCode?
  province       Province?   @relation(fields: [provinceId], references: [id])
  provinceId     String?     @db.VarChar(2)

  @@map("village")
}

model VbTargets {
  businessYear       String    @map("businessyear") @db.VarChar
  membersLastYear    BigInt    @map("members_lastyear")
  membersTarget      BigInt    @map("members_target")
  savingsLastYear    BigInt    @map("savings_lastyear")
  savingsTarget      BigInt    @map("savings_target")
  loansLastYear      BigInt    @map("loans_lastyear")
  loansTarget        BigInt    @map("loans_target")
  parLastYear        Decimal   @map("par_lastyear") @db.Decimal
  parTarget          Decimal   @map("par_target") @db.Decimal
  profitLastYear     BigInt    @map("profit_lastyear")
  profitTarget       BigInt    @map("profit_target")
  savingRateLastYear Decimal   @map("savingrate_lastyear") @db.Decimal
  savingRateTarget   Decimal   @map("savingrate_target") @db.Decimal
  vbCode             String    @map("vbcode") @db.VarChar(7)
  synchronized       DateTime? @db.Timestamp(6)
  needSync           String?   @map("need_sync") @db.VarChar(1)
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date

  vb VbCode @relation(fields: [vbCode], references: [id])

  @@id([businessYear, vbCode])
  @@map("vb_targets")
}

model VbServiceDays {
  id                Int       @id @default(autoincrement())
  serviceDayPlanned DateTime  @map("serviceday_planned") @db.Date
  startDateTime     DateTime  @map("start_date_time") @db.Timestamp(6)
  endDateTime       DateTime  @map("end_date_time") @db.Timestamp(6)
  comment           String?   @db.VarChar
  vbCode            String    @map("vbcode") @db.VarChar(7)
  nsoEmployeeId     String    @map("nso_employee_id") @db.VarChar(6)
  synchronized      DateTime? @db.Timestamp(6)
  needSync          String?   @map("need_sync") @db.VarChar(1)
  cashSw            BigInt?   @map("cash_sw")
  cashBox           BigInt?   @map("cash_box")
  cashBook          BigInt?   @map("cash_book")
  serviceDayEnd     String?   @map("service_day_end") @db.VarChar(10)
  closeMeeting      String?   @map("close_meeting") @db.VarChar(10)

  vb          VbCode      @relation(fields: [vbCode], references: [id])
  nsoEmployee NsoEmployee @relation(fields: [nsoEmployeeId], references: [id])

  @@map("vb_servicedays")
}

// ============================================================
// Client Management Tables
// ============================================================

model Client {
  id               String    @id @db.Uuid
  bankbookNumber   String?   @map("bankbooknumber") @db.VarChar(5)
  firstName        String?   @map("firstname") @db.VarChar
  lastName         String?   @map("lastname") @db.VarChar
  nickName         String    @map("nickname") @db.VarChar
  genderEng        String?   @map("gender_eng") @db.VarChar(50)
  genderLao        String?   @map("gender_lao") @db.VarChar
  birthDate        DateTime? @map("birthdate") @db.Date
  clientType       String    @map("client_type") @db.VarChar
  statusId         String    @map("status_id") @db.VarChar(1)
  email            String?   @db.VarChar
  phoneNumber      String?   @map("phonenumber") @db.VarChar(12)
  economicStatusId String?   @map("economic_status_id") @db.VarChar(1)
  professionId     String?   @map("profession_id") @db.VarChar(2)
  beneficiaryLao   String?   @map("beneficiary_lao") @db.VarChar
  vbCode           String    @map("vbcode") @db.VarChar(7)
  sortNo           String?   @map("sort_no") @db.VarChar(4)
  isGuarantor      String?   @map("is_guarantor") @db.VarChar(1)
  guarantorVolume  Int?      @map("guarantor_volume")
  synchronized     DateTime? @db.Timestamp(6)
  needSync         String?   @map("need_sync") @db.VarChar(1)
  civilStatusId    String?   @map("civil_status_id") @db.VarChar(2)
  ethnicId         String?   @map("ethnic_id") @db.VarChar(2)

  status                 Status?                 @relation(fields: [statusId], references: [id])
  economicStatus         EconomicStatus?         @relation(fields: [economicStatusId], references: [id])
  profession             Profession?             @relation(fields: [professionId], references: [id])
  vb                     VbCode                  @relation(fields: [vbCode], references: [id])
  idDocuments            IdDocument[]
  accountOwners          AccountOwner[]
  clientLoanArrangements ClientLoanArrangement[]
  vbCommitteeTeams       VbCommitteeTeam[]
  profitDistrVbcs        ProfitDistrVbc[]
  clientAccount          ClientAccount?

  @@map("client")
}

model ClientAccount {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid
  vbCode   String @map("vbcode") @db.VarChar(7)
  password String @db.Text

  client Client @relation(fields: [clientId], references: [id])
  vb     VbCode @relation(fields: [vbCode], references: [id])

  @@map("client_account")
}

model IdDocument {
  id                 BigInt    @id @default(autoincrement())
  documentNameLao    String?   @map("document_name_lao") @db.VarChar
  documentNameEng    String?   @map("document_name_eng") @db.VarChar
  idDocumentDate     DateTime? @map("iddocumentdate") @db.Date
  idDocumentNumber   String?   @map("iddocmentnumber") @db.VarChar
  fambookIndivNumber String?   @map("fambook_indiv_number") @db.VarChar
  placeOfIssueEng    String?   @map("place_of_issue_eng") @db.VarChar
  placeOfIssueLao    String?   @map("place_of_isue_lao") @db.VarChar
  clientId           String    @map("client_id") @db.Uuid
  sortNo             String?   @map("sort_no") @db.VarChar(4)
  vbCode             String    @map("vbcode") @db.VarChar(7)
  synchronized       DateTime? @db.Timestamp(6)
  change             String?   @db.VarChar(2)
  needSync           String?   @map("need_sync") @db.VarChar(1)
  householdWorks     String?   @map("household_works") @db.VarChar

  client Client @relation(fields: [clientId], references: [id])

  @@map("id_document")
}

model AccountOwner {
  bankbookNumber String    @map("bankbooknumber") @db.VarChar(5)
  accNumber      String    @map("acc_number") @db.VarChar(15)
  clientId       String    @map("client_id") @db.Uuid
  synchronized   DateTime? @db.Timestamp(6)
  needSync       String?   @map("need_sync") @db.VarChar(1)
  vbCode         String    @map("vbcode") @db.VarChar(7)

  client  Client   @relation(fields: [clientId], references: [id])
  account Accounts @relation(fields: [accNumber], references: [accNumber])
  vb      VbCode   @relation(fields: [vbCode], references: [id])

  @@id([bankbookNumber, accNumber, clientId])
  @@map("account_owner")
}

// ============================================================
// Account & Chart of Accounts Tables
// ============================================================

model Accounts {
  accNumber           String    @id @map("acc_number") @db.VarChar(15)
  accCode             String?   @map("acc_code") @db.VarChar(15)
  accCodeId           String?   @map("acc_code_id") @db.VarChar(7)
  accLevel            String    @map("acc_level") @db.VarChar(1)
  accGroup            String    @map("acc_group") @db.VarChar(1)
  accNameEng          String?   @map("acc_name_eng") @db.VarChar
  accNameLao          String?   @map("acc_name_lao") @db.VarChar
  bankbookNumber      String?   @map("bankbooknumber") @db.VarChar(5)
  accTypeId           String?   @map("acc_type_id") @db.VarChar(1)
  runningAccNo        String?   @map("running_acc_no") @db.VarChar(1)
  balancePreviousDate BigInt?   @map("balance_previous_date")
  totalAmountIncrease BigInt?   @map("total_amount_increase")
  totalAmountDecrease BigInt?   @map("total_amount_decrease")
  currentBalance      BigInt    @map("current_balance")
  lastUpdate          DateTime? @map("last_update") @db.Date
  statusId            String    @map("status_id") @db.VarChar(1)
  vbCode              String    @map("vbcode") @db.VarChar(7)
  openingDate         DateTime  @map("opening_date") @db.Date
  closingDate         DateTime? @map("closing_date") @db.Date
  canBeNegative       String?   @map("can_be_negative") @db.VarChar(1)
  accBalanceSide      String?   @map("acc_balanceside") @db.VarChar(1)
  isBalanceAcc        String?   @map("is_balance_acc") @db.VarChar(1)
  parentAccCode       String?   @map("parent_acc_code") @db.VarChar(15)
  parentAcc           String?   @map("parent_acc") @db.VarChar(15)
  receivesDividend    String?   @map("receives_dividend") @db.VarChar(1)
  isLedger            String?   @map("is_ledger") @db.VarChar(1)
  synchronized        DateTime? @db.Timestamp(6)
  isProfitAndLossAcc  String?   @map("is_profit_and_loss_acc") @db.VarChar(1)
  isTrialBalanceAcc   String?   @map("is_trial_balance_acc") @db.VarChar(1)
  pnlCategory         String?   @map("pnl_category") @db.VarChar(6)
  ledgerPosition      String?   @map("ledgerposition") @db.VarChar(6)
  balancePosition     String?   @map("balanceposition") @db.VarChar(6)
  needSync            String?   @map("need_sync") @db.VarChar(1)
  restructuringLoan   Boolean?  @map("restructuring_loan")

  accountType   AccountType?   @relation(fields: [accTypeId], references: [id])
  status        Status         @relation(fields: [statusId], references: [id])
  vb            VbCode         @relation(fields: [vbCode], references: [id])
  accountOwners AccountOwner[]
  transactions  Transactions[]

  @@map("accounts")
}

model AccountType {
  id          String  @id @db.VarChar(1)
  nameEng     String  @map("name_eng") @db.VarChar
  nameLao     String  @map("name_lao") @db.VarChar
  description String? @db.VarChar
  needSync    String? @map("need_sync") @db.VarChar(1)

  accounts Accounts[]

  @@map("account_type")
}

model ChartOfAccounts {
  accNumber           String?   @db.VarChar(15)
  accCode             String    @id @db.VarChar(50)
  accCodeId           String    @map("acc_code_id") @db.VarChar(7)
  accLevel            String?   @db.VarChar
  accGroup            String    @map("acc_group") @db.VarChar(2)
  accNameEng          String    @map("acc_name_eng") @db.VarChar
  accNameLao          String    @map("acc_name_lao") @db.VarChar
  bankbookNo          String?   @map("bankbook_no") @db.VarChar(5)
  accTypeId           String?   @map("acc_type_id") @db.VarChar(2)
  runningAccNo        String?   @map("running_acc_no") @db.VarChar(2)
  balancePreviousDate BigInt?   @map("balance_previous_date")
  totalAmountIncrease BigInt?   @map("total_amount_increase")
  totalAmountDecrease BigInt?   @map("total_amount_decrease")
  currentBalance      BigInt?   @map("current_balance")
  lastUpdate          DateTime? @map("last_update") @db.Date
  statusId            String    @map("status_id") @db.VarChar(1)
  vbCode              String?   @map("vb_code") @db.VarChar(7)
  openingDate         DateTime? @map("opening_dete") @db.Date
  closingDate         DateTime? @map("closing_date") @db.Date
  canBeNegative       String?   @map("can_be_negative") @db.VarChar(1)
  accBalanceSide      String    @map("acc_balanceside") @db.VarChar(1)
  isBalanceAcc        String?   @map("is_balance_acc") @db.VarChar(1)
  parentAccCode       String?   @map("parent_acc_code") @db.VarChar(7)
