model NsoFeeTransaction {
  id                            BigInt    @id @default(autoincrement())
  date                          DateTime  @db.Date
  nsoFeeModelId                 BigInt    @map("nso_fee_model_id")
  totalOutstandingLoan          BigInt    @map("total_outstanding_loan")
  wslFromNso                    BigInt    @map("wsl_from_nso")
  outstandingLoanMinusWsl       BigInt    @map("outstandingloan_minus_wsl")
  nsoFeeDueThisMonth            Int       @map("nso_fee_due_this_month")
  nsoFeeDueAccumCurrentBusYear  BigInt    @map("nso_fee_due_accum_current_bus_year")
  nsoFeePaidThisMonth           Int       @map("nso_fee_paid_this_month")
  nsoFeePaidAccumCurrentBusYear BigInt    @map("nso_fee_paid_accum_current_bus_year")
  nsoFeeUnpaid                  Int
  vbCode                        String    @map("vbcode") @db.VarChar(7)
  synchronized                  DateTime? @db.Timestamp(6)
  needSync                      String?   @map("need_sync") @db.VarChar(1)
  nsoVat                        BigInt?   @map("nso_vat")
  nsoFeeDue                     BigInt?   @map("nso_fee_due")
  nsoVatThisMonth               BigInt?   @map("nso_vat_this_month")
